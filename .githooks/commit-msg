#!/usr/bin/env bash
set -euo pipefail

MSG_FILE="$1"
REPO_ROOT="$(git rev-parse --show-toplevel)"
MATVERSE_DIR="${REPO_ROOT}/.git/matverse"
KEY_PRIV="${MATVERSE_DIR}/commit_signing_ed25519"
KEY_PUB="${MATVERSE_DIR}/commit_signing_ed25519.pub"
RECEIPTS_DIR="${MATVERSE_DIR}/receipts"

mkdir -p "${RECEIPTS_DIR}"

if [[ ! -f "${KEY_PRIV}" || ! -f "${KEY_PUB}" ]]; then
  echo "PBSE: chave de assinatura ausente em ${KEY_PRIV}(.pub)."
  exit 1
fi

if ! command -v ssh-keygen >/dev/null 2>&1; then
  echo "PBSE: ssh-keygen não encontrado."
  exit 1
fi

sha3_256() {
  if command -v openssl >/dev/null 2>&1; then
    printf "%s" "$1" | openssl dgst -sha3-256 | awk '{print $NF}'
    return 0
  fi
  if command -v python3 >/dev/null 2>&1; then
    python3 - <<'PY' "$1"
import sys
import hashlib

data = sys.argv[1].encode("utf-8", errors="surrogatepass")
print(hashlib.sha3_256(data).hexdigest())
PY
    return 0
  fi
  echo "PBSE: openssl ou python3 necessários para SHA3-256."
  exit 1
}

REPO_NAME="$(basename "${REPO_ROOT}")"
BRANCH="$(git rev-parse --abbrev-ref HEAD)"
AUTHOR_NAME="$(git config user.name || true)"
AUTHOR_EMAIL="$(git config user.email || true)"
TS_UTC="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
STAGED_PATCH="$(git diff --cached --binary)"
PATCH_HASH="$(sha3_256 "${STAGED_PATCH}")"

RECEIPT_ID="${TS_UTC//[:TZ-]/}_${REPO_NAME}_${BRANCH}_${PATCH_HASH:0:16}"
RECEIPT_JSON="${RECEIPTS_DIR}/${RECEIPT_ID}.json"
RECEIPT_SIG="${RECEIPTS_DIR}/${RECEIPT_ID}.sig"

cat > "${RECEIPT_JSON}" <<JSON
{
  "schema": "matverse.pbse.receipt.v1",
  "ts_utc": "${TS_UTC}",
  "repo_root": "${REPO_ROOT}",
  "repo_name": "${REPO_NAME}",
  "branch": "${BRANCH}",
  "author": {
    "name": "${AUTHOR_NAME}",
    "email": "${AUTHOR_EMAIL}"
  },
  "git": {
    "head": "$(git rev-parse HEAD 2>/dev/null || echo "0000000000000000000000000000000000000000")",
    "index_patch_sha3_256": "${PATCH_HASH}"
  }
}
JSON

ssh-keygen -Y sign -q -f "${KEY_PRIV}" -n "matverse.pbse" "${RECEIPT_JSON}" > "${RECEIPT_SIG}"

SIG_SHA256="$(
  if command -v openssl >/dev/null 2>&1; then
    openssl dgst -sha256 "${RECEIPT_SIG}" | awk '{print $NF}'
  else
    python3 - <<'PY' "${RECEIPT_SIG}"
import sys
import hashlib

with open(sys.argv[1], "rb") as handle:
    print(hashlib.sha256(handle.read()).hexdigest())
PY
  fi
)"

TMP="$(mktemp)"
awk '
{
  if ($0 ~ /^Coherence-Receipt:/) next;
  if ($0 ~ /^Coherence-Sig:/) next;
  print $0;
}
' "${MSG_FILE}" > "${TMP}"

if [[ -s "${TMP}" ]]; then
  tail -n 1 "${TMP}" | grep -q '^[[:space:]]*$' || echo "" >> "${TMP}"
fi

{
  echo "Coherence-Receipt: ${RECEIPT_ID}"
  echo "Coherence-Sig: sha256:${SIG_SHA256}"
} >> "${TMP}"

mv "${TMP}" "${MSG_FILE}"
